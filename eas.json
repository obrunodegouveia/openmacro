{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "22.18.0",
      "env": {
        "EXPO_PUBLIC_DATA_PROVIDER": "local",
        "EXPO_PUBLIC_ENABLE_HAPTICS": "true",
        "EXPO_PUBLIC_ENABLE_SOUND": "true"
      }
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_VALIDATE_CONTENT": "true"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_VALIDATE_CONTENT": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_VALIDATE_CONTENT": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "en-US",
        "metadataPath": "./store.config.json",
        "appName": "OpenMacro Economics",
        "sku": "OPENMACRO001"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    }
  }
}
