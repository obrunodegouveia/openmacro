{
  "name": "@openmacro/seasons",
  "version": "2.0.0",
  "private": true,
  "description": "Seasonal themes for any React Native or React web app: six seasons as data, renderers for both, a calendar with movable feasts, a viewer preference, a remote kill switch and a pre-paint boot script.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./presets": "./src/presets/index.ts",
    "./native": "./src/native/index.ts",
    "./web": "./src/web.ts",
    "./web/boot": "./src/web/boot.ts",
    "./web/provider": "./src/web/provider.ts",
    "./web/art/halloween": "./src/web/art/halloween.tsx",
    "./web/styles.css": "./src/web/styles.css",
    "./react": "./src/react.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "build": "node scripts/build.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "peerDependencies": {
    "expo-haptics": "*",
    "react": ">=18",
    "react-native": ">=0.81",
    "react-native-gesture-handler": ">=2.20",
    "react-native-reanimated": ">=4",
    "react-native-worklets": ">=0.5"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css"
  ]
}
