# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# OpenMacro
.env

# web/ is the Next.js site served at openmacro.org. Its own .gitignore
# excludes node_modules and .next, so only source is tracked.

# Store credentials. Nothing here belongs in git: the App Store Connect API
# key, the Google Play service account and any signing material EAS hands back.
# `*.p8`, `*.p12`, `*.jks`, `*.key` and `*.mobileprovision` are covered above;
# these are the paths eas-cli reaches for by name.
credentials/
credentials.json
google-play-service-account*.json
*.keystore
translations/
