{
  "expo": {
    "name": "OpenMacro",
    "slug": "openmacro",
    "owner": "care-to-beauty",
    "version": "1.0.0",
    "description": "Duolingo-style micro-learning for macroeconomics, monetary policy and fractional-reserve banking. Five minutes a day, no account needed.",
    "orientation": "portrait",
    "icon": "./assets/brand/v3/openmacro-icon-light.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#2FBF71",
    "ios": {
      "icon": "./assets/brand/v3/OpenMacro.icon",
      "supportsTablet": true,
      "bundleIdentifier": "org.openmacro.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "pt-PT"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3EDE5",
        "foregroundImage": "./assets/brand/v3/openmacro-android-foreground.png",
        "monochromeImage": "./assets/brand/v3/openmacro-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.openmacro.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/brand/v3/openmacro-favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/v3/openmacro-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F9FB"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "scheme": "openmacro",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bda4f7da-046e-4b61-9041-cb2aaaf13b8b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/bda4f7da-046e-4b61-9041-cb2aaaf13b8b",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
