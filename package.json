{
  "name": "openmacro",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@openmacro/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@typescript-eslint/parser": "^8",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9",
    "typescript": "~6.0.3",
    "typescript-native": "npm:typescript@~7.0.2"
  },
  "scripts": {
    "brand:export": "node ./scripts/export-brand.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "typecheck:core": "node ./node_modules/typescript-native/bin/tsc -p packages/core --noEmit",
    "gen:sounds": "node ./scripts/generate-sounds.mjs",
    "audit:content": "node ./scripts/audit-content.mjs",
    "lint:content": "node ./scripts/validate-content.mjs",
    "check:exam": "node ./scripts/check-exam.mjs",
    "check:feedback": "node ./scripts/check-feedback.mjs",
    "check:review": "node ./scripts/check-review.mjs",
    "check:fingerprint": "node ./scripts/check-fingerprint.mjs",
    "check:objectives": "node ./scripts/check-objectives.mjs",
    "build:web": "expo export --platform web",
    "doctor": "npx expo-doctor@latest",
    "native:prebuild": "expo prebuild --clean --no-install",
    "preflight:store": "node ./scripts/preflight-store.mjs",
    "asc:appinfo": "node ./scripts/asc-appinfo.mjs",
    "asc:pricing": "node ./scripts/asc-pricing.mjs",
    "asc:listing": "node ./scripts/asc-listing.mjs",
    "asc:screenshots": "node ./scripts/asc-screenshots.mjs",
    "asc:status": "node ./scripts/asc-status.mjs",
    "asc:submit": "node ./scripts/asc-submit.mjs",
    "shots:ios": "node ./scripts/screenshots-ios.mjs",
    "update:preview": "npm run lint:content && npm run update:check -- --channel preview && npx eas-cli@24 update --channel preview --environment preview --message \"$(git log -1 --pretty=%s)\" --non-interactive",
    "update:store": "npm run lint:content && npm run audit:content && npm run update:check && npx eas-cli@24 update --channel production --environment production --message \"$(git log -1 --pretty=%s)\" --non-interactive",
    "update:status": "npx eas-cli@24 channel:list",
    "update:list": "npx eas-cli@24 update:list --limit 10",
    "update:rollback": "npx eas-cli@24 update:rollback",
    "update:pause": "npx eas-cli@24 channel:pause --channel production",
    "update:resume": "npx eas-cli@24 channel:resume --channel production",
    "build:dev:ios": "npx eas-cli@24 build --profile development --platform ios",
    "build:dev:android": "npx eas-cli@24 build --profile development --platform android",
    "build:preview": "npx eas-cli@24 build --profile preview --platform all",
    "build:store": "npm run preflight:store && npx eas-cli@24 build --profile production --platform all",
    "build:store:ios": "npm run preflight:store && npx eas-cli@24 build --profile production --platform ios --local",
    "build:store:android": "npm run preflight:store && npx eas-cli@24 build --profile production --platform android --local",
    "upload:ios": "node ./scripts/upload-ios.mjs",
    "submit:ios": "npm run preflight:store && npx eas-cli@24 submit --profile production --platform ios",
    "submit:android": "npm run preflight:store && npx eas-cli@24 submit --profile production --platform android",
    "metadata:push": "npm run preflight:store -- --metadata && npx eas-cli@24 metadata:push",
    "metadata:pull": "npx eas-cli@24 metadata:pull",
    "i18n:status": "node ./scripts/i18n.mjs status",
    "i18n:extract": "node ./scripts/i18n.mjs extract",
    "lint": "eslint app src",
    "i18n:import": "node ./scripts/i18n.mjs import",
    "i18n:fixspelling": "node ./scripts/i18n.mjs fixspelling",
    "update:check": "node ./scripts/update-reachability.mjs",
    "release:record": "node ./scripts/update-reachability.mjs --record"
  },
  "private": true,
  "description": "Duolingo-style micro-learning app teaching macroeconomics, monetary policy and fractional-reserve banking.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "web"
  ]
}
