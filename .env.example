# ============================================================================
# OpenMacro environment
# ============================================================================
#
# Copy to `.env` and adjust. Every variable here is PUBLIC: Expo inlines
# EXPO_PUBLIC_* into the JavaScript bundle at build time, so it ships to every
# device. Never put a secret, API key or token in this file.
#
#   cp .env.example .env
#
# Restart the dev server after editing (`npx expo start --clear`).
#
# This file is for local development only. An EAS build never reads it: the
# switches come from the build profile's `env` block in `eas.json`, and the
# Supabase credentials from EAS environment variables. Adding a value here and
# expecting it in a store build is the mistake to avoid — see
# docs/mobile-release.md.

# Where progress is stored on this device while signed out.
#   local  - AsyncStorage; survives restarts (default)
#   mock   - in-memory only, resets every launch; good for demos and tests
EXPO_PUBLIC_DATA_PROVIDER=local

# ---------------------------------------------------------------------------
# Cloud sync (optional)
# ---------------------------------------------------------------------------
# Leave both blank and OpenMacro runs exactly as it does today: fully offline,
# no accounts, and no sign-in UI anywhere in the app. That is the default for a
# fresh clone, and contributors never need a Supabase project.
#
# Fill both in to enable "Continue with Google" and cross-device progress.
# Setup is one-time and documented in docs/cloud-sync.md.
#
# The anon key is PUBLIC by design and safe to ship: row-level security limits
# it to the signed-in learner's own rows. Never put the service_role key or the
# Google client secret here — the secret belongs in Supabase, nowhere else.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Feedback switches. Handy when you are working in a quiet room, or when
# haptics get annoying during a long debugging session.
EXPO_PUBLIC_ENABLE_HAPTICS=true
EXPO_PUBLIC_ENABLE_SOUND=true

# Which set of feedback clips to play.
#   classic  tuned tones in C — the default
#   arcade   bent pitches and cartoon drops
# Both are synthesised by `npm run gen:sounds` and MIT like the rest of the
# repository. Anything unrecognised falls back to classic.
EXPO_PUBLIC_SOUND_PACK=classic

# Measure how long the audio rewind before each cue takes and print one
# summary line. Self-limiting: a bounded sample, one log, then off. Set to
# false to silence it entirely.
EXPO_PUBLIC_AUDIO_TIMING=true

# Validate the bundled lesson content on app boot and print any issues to the
# Metro console. Defaults to on in development, off in production builds.
EXPO_PUBLIC_VALIDATE_CONTENT=true
